#!/usr/bin/env bash
set -euo pipefail

: "${GH_REPOSITORY:?GH_REPOSITORY is required}"
: "${GH_PR_NUMBER:?GH_PR_NUMBER is required}"

is_factory_path() {
  case "$1" in
    .agents/* | .amp/plugins/factory/* | .github/* | docs/automations/* | docs/factory/* | docs/guardrails/* | AGENTS.md | CLAUDE.md | bin/check-* | hk.pkl | mise.toml | rust-toolchain.toml | deny.toml | .gitleaks.toml)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

changed_paths="$(gh api --paginate "repos/$GH_REPOSITORY/pulls/$GH_PR_NUMBER/files" --jq '.[] | .filename, (.previous_filename // empty)')"
factory_changed=0

while IFS= read -r path; do
  if [[ -n "$path" ]] && is_factory_path "$path"; then
    factory_changed=1
    break
  fi
done <<<"$changed_paths"

if ((factory_changed == 0)); then
  printf '%s\n' 'Factory approval not required.'
  exit 0
fi

head_sha="$(gh api "repos/$GH_REPOSITORY/pulls/$GH_PR_NUMBER" --jq '.head.sha')"
approvals="$(gh api --paginate "repos/$GH_REPOSITORY/pulls/$GH_PR_NUMBER/reviews" --jq ".[] | select(.state == \"APPROVED\") | select(.commit_id == \"$head_sha\") | select(.user.type == \"User\") | select(.author_association == \"OWNER\" or .author_association == \"MEMBER\" or .author_association == \"COLLABORATOR\") | .id")"

if [[ -z "$approvals" ]]; then
  printf '%s\n' 'FACTORY APPROVAL REQUIRED: a trusted human must approve the current PR head'
  exit 1
fi

printf '%s\n' 'Factory change has current-head human approval.'
