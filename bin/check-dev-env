#!/usr/bin/env bash
set -euo pipefail

failures=0

require_path() {
  if [[ ! -e "$1" ]]; then
    printf 'MISSING: %s\n' "$1"
    failures=$((failures + 1))
  fi
}

paths=(
  Cargo.toml
  Cargo.lock
  rust-toolchain.toml
  mise.toml
  hk.pkl
  deny.toml
  .gitleaks.toml
  AGENTS.md
  CLAUDE.md
  CONTEXT.md
  SPEC.md
  docs/ARCHITECTURE.md
  factory/readme.md
  factory/roadmap.md
  factory/invariants.md
  factory/queues.json
  factory/automations/config.json
  CONTRIBUTING.md
  LICENSE
  CHANGELOG.md
  docs/MISTAKES.md
  docs/LEARNINGS.md
  docs/DESIRES.md
  docs/history/README.md
  docs/history/phase-0-plan.md
  docs/history/phase-0-report.md
  factory/agents/chief-of-staff.json
  factory/agents/issue-worker.json
  factory/agents/reviewer.json
  factory/agents/conflict-resolver.json
  factory/agents/qa-explorer.json
  factory/agents/bug-finder.json
  factory/agents/factory-improver.json
  factory/agents/maintenance.json
  .agents/setup
  .agents/resume
  .amp/plugins/factory/index.ts
  bin/check-no-comments
)

for path in "${paths[@]}"; do
  require_path "$path"
done

for crate in deadmanssnitch mcp-deadmanssnitch deadmanssnitch-twin deadmanssnitch-conformance; do
  require_path "projects/$crate/Cargo.toml"
done

for guard in rust-code testing-and-proof tool-contract-stability errors-and-retries dependencies twin-fidelity factory-operation; do
  require_path "factory/guardrails/$guard.md"
done

for removed in .python-version .pre-commit-config.yaml .envrc .claude docs/PLAN.md; do
  if [[ -e "$removed" ]]; then
    printf 'REMOVED PATH: %s\n' "$removed"
    failures=$((failures + 1))
  fi
done

if [[ -f .env ]] && grep -q '^DEADMANSSNITCH_API_KEY=' .env; then
  printf '%s\n' 'INVALID ENV: use DEADMANSNITCH_API_KEY'
  failures=$((failures + 1))
fi

if ! grep -q '^rust = "1.88.0"' mise.toml || ! grep -q '^channel = "1.88.0"' rust-toolchain.toml; then
  printf '%s\n' 'TOOLCHAIN DRIFT: mise and rust-toolchain must both pin 1.88.0'
  failures=$((failures + 1))
fi

if ! cargo metadata --no-deps --format-version 1 >/dev/null; then
  printf '%s\n' 'FAILED: cargo metadata'
  failures=$((failures + 1))
fi

if ! hk config dump >/dev/null; then
  printf '%s\n' 'FAILED: hk config dump'
  failures=$((failures + 1))
fi

for task in lint lint:secrets test build; do
  if ! mise run "$task"; then
    printf 'FAILED: mise run %s\n' "$task"
    failures=$((failures + 1))
  fi
done

if ! npm --prefix factory/amp/plugin run typecheck; then
  printf '%s\n' 'FAILED: factory plugin typecheck'
  failures=$((failures + 1))
fi

if ! git diff --check || ! git diff --cached --check; then
  printf '%s\n' 'FAILED: git diff check'
  failures=$((failures + 1))
fi

if ((failures == 0)); then
  printf '%s\n' 'Development environment checks passed.'
else
  printf '%s development environment check(s) failed.\n' "$failures"
fi

exit "$failures"
