#!/usr/bin/env fish
set file $argv[1]
if test -z "$file"; or not test -f "$file"
    echo "commit message file is required" >&2
    exit 1
end
if not string match -rq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+' -- (head -n 1 "$file")
    echo "commit message must use Conventional Commits" >&2
    exit 1
end
